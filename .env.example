# Backend API Port (for local development only, Vercel uses serverless)
PORT=3001

# Database (Vercel Postgres)
POSTGRES_URL="postgres://default:xxxxx@xxxx-xxxx-xxxxx.postgres.vercel-storage.com/verceldb"
POSTGRES_PRISMA_URL="postgres://default:xxxxx@xxxx-xxxx-xxxxx.postgres.vercel-storage.com/verceldb?pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NO_SSL="postgres://default:xxxxx@xxxx-xxxx-xxxxx.postgres.vercel-storage.com/verceldb"
POSTGRES_URL_NON_POOLING="postgres://default:xxxxx@xxxx-xxxx-xxxxx.postgres.vercel-storage.com/verceldb"
POSTGRES_USER="default"
POSTGRES_HOST="xxxx-xxxx-xxxxx.postgres.vercel-storage.com"
POSTGRES_PASSWORD="xxxxx"
POSTGRES_DATABASE="verceldb"

# Prefer `npm run migrate:postgres` during deployment. Enable only for fresh
# environments that intentionally need schema migration during cold start.
POSTGRES_AUTO_MIGRATE="false"

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN="YOUR_BOT_TOKEN_HERE"
TELEGRAM_CHAT_ID="YOUR_CHAT_ID_HERE"
FAMILY_CHAT_ID="YOUR_CHAT_ID_HERE"
TELEGRAM_WEBHOOK_SECRET="YOUR_TELEGRAM_WEBHOOK_SECRET"

# Cloudflare Access service token (optional, for machine clients that call protected admin APIs)
BOOKING_MANAGER_CF_ACCESS_CLIENT_ID="YOUR_CF_ACCESS_CLIENT_ID"
BOOKING_MANAGER_CF_ACCESS_CLIENT_SECRET="YOUR_CF_ACCESS_CLIENT_SECRET"

# Defense-in-depth for custom-domain admin routes. Enable only after confirming
# Cloudflare forwards cf-access-jwt-assertion to the Vercel origin.
REQUIRE_CF_ACCESS_IDENTITY="false"

# Cloudflare Access for server-to-server Booking API calls (optional)
CF_ACCESS_CLIENT_ID="YOUR_CF_ACCESS_CLIENT_ID"
CF_ACCESS_CLIENT_SECRET="YOUR_CF_ACCESS_CLIENT_SECRET"

# iCal URLs (JSON string)
# Format: [{"id":"apartment_id","name":"Apartment Name","booking_url":"https://...","airbnb_url":"https://..."}]
ICAL_URLS='[]'

# Sync protection and freshness health thresholds
ICAL_FETCH_TIMEOUT_MS="12000"
ICAL_FETCH_RETRIES="2"
BOOKING_STALE_GRACE_HOURS="6"
HEALTH_SYNC_STALE_MINUTES="1560"

# Guest reporting (Alloggiati Web + Sinfonia Turismo SMART)
# Generate with: openssl rand -base64 32
REPORTING_PII_ENCRYPTION_KEY="BASE64_32_BYTE_KEY"
REPORTING_PII_KEY_VERSION="v1"
REPORTING_PII_RETENTION_DAYS="30"
# Keep false until Alloggiati Test and Sinfonia test-environment checks pass.
REPORTING_EXTERNAL_SEND_ENABLED="false"
ALLOGGIATI_TIMEOUT_MS="15000"
ISTAT_TIMEOUT_MS="15000"
# Override with the official test environment during integration testing.
ISTAT_API_BASE_URL="https://turismo.regione.campania.it/turismoweb/api-gestionali"

# San Sebastiano and Dragone share one Gestione Appartamenti account. Their
# non-secret apartment IDs are mapped in backend/config/reporting-units.json.
ALLOGGIATI_CRISTALLPONT_USER=""
ALLOGGIATI_CRISTALLPONT_PASSWORD=""
ALLOGGIATI_CRISTALLPONT_WSKEY=""

# Repeat the Alloggiati trio for HARMONY, CARINA and ROYAL when available.
ISTAT_DRAGONE_CUSR=""
ISTAT_DRAGONE_API_KEY=""

# Used by calendar sync and reporting maintenance cron endpoints.
CRON_SECRET="YOUR_CRON_SECRET"

# Google Calendar API (optional, for backup sync)
GOOGLE_CALENDAR_CREDENTIALS='{"client_id":"...","client_secret":"...","refresh_token":"..."}'
