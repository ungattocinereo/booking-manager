{
  "name": "atrani-booking-manager",
  "version": "1.0.0",
  "description": "Booking and cleaning calendar management system for Atrani properties",
  "main": "backend/src/server.js",
  "scripts": {
    "start": "node backend/src/server.js",
    "dev": "nodemon backend/src/server.js",
    "sync": "node backend/src/sync-calendars.js",
    "enrich": "node scripts/enrich-bookings.js",
    "audit:data": "node scripts/audit-production-data.js",
    "backup:data": "node scripts/backup-production-data.js",
    "migrate:postgres": "node scripts/migrate-postgres.js",
    "test": "npm run test:unit && npm run test:booking-lifecycle",
    "test:unit": "node --test tests/*.test.js",
    "test:booking-lifecycle": "node scripts/test-booking-lifecycle.js",
    "test:ui": "node scripts/test-ui-performance.js",
    "test:syntax": "node scripts/check-js-syntax.js",
    "test:ci": "npm run test:syntax && npm test && npm run test:ui"
  },
  "keywords": [
    "booking",
    "calendar",
    "ical",
    "airbnb",
    "booking.com",
    "cleaning"
  ],
  "author": "Greg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ungattocinereo/booking-manager.git"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "fast-xml-parser": "^5.10.1",
    "ical.js": "^1.5.0",
    "node-fetch": "^2.6.7",
    "pg": "^8.20.0",
    "playwright": "^1.58.2",
    "sqlite3": "^6.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "picomatch": "2.3.2"
  },
  "overrides": {
    "path-to-regexp": "0.1.13"
  }
}
